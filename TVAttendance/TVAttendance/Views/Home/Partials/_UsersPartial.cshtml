@model IEnumerable<TVAttendance.ViewModels.UsersVM>
<form asp-action="Index" asp-controller="Home" enctype="multipart/form-data">
    <h4>All Users & Roles</h4>
    <table class="table">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
        </tr>
        @foreach (var user in ViewBag.Users)
        {
            <tr>
                <td>@user.Name</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
            </tr>
        }
    </table>
</form>