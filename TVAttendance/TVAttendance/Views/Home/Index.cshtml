@{
    //List of all user roles to determine which dashboard to show
    var userRoles = User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
}

@if (userRoles.Contains("Admin"))
{
    <h2>Admin Dashboard</h2>
    <div class="d-flex gap-3">
        <div class="col-md-6 flex-column">
            <partial name="Partials/_EventsIndexPartial" />
        </div>

        <div class="col-md-6 flex-column">
            <h4>All Users & Roles</h4>
            <table class="table">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var user in ViewBag.Users)
                {
                    <tr>
                        <td>@user.Name</td>
                        <td>@user.Email</td>
                        <td>@user.Role</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

