@{
    //List of all user roles to determine which dashboard to show
    var userRoles = User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
}

@if (userRoles.Contains("Admin"))
{
    <div class="text-center mt-3">
        <h2 class="mb-3">Admin Dashboard</h2>
        <hr />
    </div>
    <div class="d-flex gap-3">
        <div class="col-md-6 flex-column" title="Click on any event to go to that event's details">
            <partial name="Partials/_EventsIndexPartial" />
        </div>

        <div class="col-md-6 flex-column">
            <h4>All Users & Roles</h4>
            <table class="table">
                <thead>
                    <tr>
                        <!--Name value is same as email, so leaving it out for now-->
                        @* <th>Name</th> *@
                        <th>Email</th>
                        <th>Role</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in ViewBag.Users)
                    {
                        <tr>
                            @* <td>@user.Name</td> *@
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="text-center mt-3">
        <h2 class="mb-3">Actions</h2>
        <div class="row g-3">
            <div class="col-md-4 d-grid">
                <a id="btnCreateEvent" type="submit" class="btn btn-outline-success" asp-action="Create" asp-controller="Event">Create Event</a>
            </div>
            <div class="col-md-4 d-grid">
                <a id="btnBulkUpload" class="btn btn-outline-warning" type="submit" asp-action="Index" asp-controller="Singer">Singer Bulk Upload</a>
            </div>
            <div class="col-md-4 d-grid">
                <a asp-action="ExportVolunteers" asp-controller="Volunteer" class="btn btn-outline-info" title="Export the volunteers to an excel (.xlsx) file">Export Volunteer Index</a>
            </div>
        </div>

    </div>
    <script src="~/js/AdminBulkUploadPress.js"></script>
    <script>
        document.getElementById("btnBulkUpload").addEventListener("click", function () {
            sessionStorage.setItem("openBulkUpload", "true");
        });
    </script>
}
@if (userRoles.Contains("User"))
{
    <div class="text-center mt-3">
        <h2 class="mb-3">Volunteer Dashboard</h2>
        <hr />
    </div>
    <div class="d-flex gap-3">
        <div class="col-md-6 flex-column" title="Click on any event to go to that event's details">
            <partial name="Partials/_ShiftsIndexPartial" />
        </div>

        <div class="col-md-6 flex-column">
            <h4>Upcoming events</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Location</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var userEvent in ViewBag.Events)
                    {
                        <tr>
                            <td>@userEvent.Name</td>
                            <td>@userEvent.Location</td>
                            <td>@userEvent.Date</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="text-center mt-2">
        <h2 class="mb-3">Details of @ViewBag.Volunteer.FullName</h2>

        <div class="row justify-content-center">
            <div class="col-md-4">
                <dl class="row">
                    <dt class="col-6 text-end fw-bold">First Name</dt>
                    <dd class="col-6 text-start">@ViewBag.Volunteer.FirstName</dd>

                    <dt class="col-6 text-end fw-bold">Last Name</dt>
                    <dd class="col-6 text-start">@ViewBag.Volunteer.LastName</dd>

                    <dt class="col-6 text-end fw-bold">Phone Number</dt>
                    <dd class="col-6 text-start">@ViewBag.Volunteer.Phone</dd>
                </dl>
            </div>
            <div class="col-md-4">
                <dl class="row">
                    <dt class="col-6 text-end fw-bold">Email</dt>
                    <dd class="col-6 text-start">@ViewBag.Volunteer.Email</dd>

                    <dt class="col-6 text-end fw-bold">Date of Birth</dt>
                    <dd class="col-6 text-start">@ViewBag.Volunteer.DOB</dd>

                    <dt class="col-6 text-end fw-bold">Register Date</dt>
                    <dd class="col-6 text-start">@ViewBag.Volunteer.RegisterDate</dd>
                </dl>
            </div>
        </div>
    </div>


}

