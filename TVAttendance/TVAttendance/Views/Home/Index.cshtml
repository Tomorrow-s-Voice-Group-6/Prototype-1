@{
    //List of all user roles to determine which dashboard to show
    var userRoles = User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
}
@if (userRoles.Contains("Admin"))
{
    <div class="text-center mt-3">
        <h2 class="mb-3">Admin Dashboard</h2>
        <hr />
    </div>
    <div class="dashboard-table">
        <div class="col-md-6 flex-column" title="Click on any event to go to that event's details">
            <partial name="Partials/_EventsIndexPartial" />
        </div>


        <div class="col-md-6 flex-column">
            <h4>All Users & Roles</h4>
            <table class="table">
                <thead>
                    <tr>
                        <!--Name value is same as email, so leaving it out for now-->
                        @* <th>Name</th> *@
                        <th>Email</th>
                        <th>Role</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in ViewBag.Users)
                    {
                        <tr>
                            @* <td>@user.Name</td> *@
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="text-center mt-3">
        <h2 class="mb-3">Actions</h2>
        <div class="row g-3">
            <div class="col-md-4 d-grid">
                <a title="Will bring you to the 'Create Event' page" id="btnCreateEvent" type="submit" class="btn btn-success py-5" asp-action="Create" asp-controller="Event">Create Event</a>
            </div>
            <div class="col-md-4 d-grid">
                <a title="Brings you to the Singer page and brings you to the 'Bulk Upload' feature"
                   id="btnBulkUpload" class="btn btn-warning py-5" type="submit" asp-action="Index" asp-controller="Singer">Singer Bulk Upload</a>
            </div>
            <div class="col-md-4 d-grid">
                <a asp-action="ExportVolunteers" asp-controller="Volunteer" class="btn btn-info py-5" title="Export the volunteers to an excel (.xlsx) file">Export All Volunteer's</a>
            </div>
        </div>
    </div>
    <script src="~/js/AdminBulkUploadPress.js"></script>
    <script>
        document.getElementById("btnBulkUpload").addEventListener("click", function () {
        sessionStorage.setItem("openBulkUpload", "true");
        });
    </script>
}

@if (userRoles.Contains("User"))
{
    <div class="text-center mt-3">
        <h2 class="mb-3">Volunteer Dashboard</h2>
        <hr />
    </div>
    <div class="dashboard-table">
        <div class="col-md-6 flex-column">
            <partial name="Partials/_ShiftsIndexPartial" />
        </div>

        <div class="col-md-6 flex-column" title="Click on any event to go to that event's details">
            <h4>Upcoming events</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Location</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var userEvent in ViewBag.Events)
                    {
                        <tr onclick="window.location.href='@Url.Action("Index", "EventShift",  
                        new { EventID = userEvent.ID })'" style="cursor:pointer;">
                            <td>@userEvent.Name</td>
                            <td>@userEvent.Location</td>
                            <td>@userEvent.Date</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="text-center mt-2">
        <h2 class="mb-3">Your Details</h2>
        <hr />
        <div class="card shadow p-3 mb-4">
            <div class="row justify-content-center fs-5">
                <div class="col-md-4">
                    <dl class="row">
                        <dt class="col-6 text-end fw-bold">First Name</dt>
                        <dd class="col-6 text-start">@ViewBag.Volunteer.FirstName</dd>

                        <dt class="col-6 text-end fw-bold">Last Name</dt>
                        <dd class="col-6 text-start">@ViewBag.Volunteer.LastName</dd>

                        <dt class="col-6 text-end fw-bold">Phone Number</dt>
                        <dd class="col-6 text-start">@ViewBag.Volunteer.Phone</dd>
                    </dl>
                </div>
                <div class="col-md-4">
                    <dl class="row">
                        <dt class="col-6 text-end fw-bold">Email</dt>
                        <dd class="col-6 text-start">@ViewBag.Volunteer.Email</dd>

                        <dt class="col-6 text-end fw-bold">Date of Birth</dt>
                        <dd class="col-6 text-start">@ViewBag.Volunteer.DOB.ToShortDateString()</dd>

                        <dt class="col-6 text-end fw-bold">Register Date</dt>
                        <dd class="col-6 text-start">@ViewBag.Volunteer.RegisterDate.ToShortDateString()</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>


}

@if (userRoles.Contains("Director"))
{
    <div class="text-center mt-3">
        <h2 class="mb-3">Director Dashboard</h2>
        <hr />
    </div>
    
    <div class="d-flex gap-3">
        <div class="col-md-6 flex-column" title="Click on any event to go to that event's details">
            <partial name="Partials/_EventsIndexPartial" />
        </div>
        
        <div class="col-md-6 flex-column">
            <h4>Recent Sessions</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>City</th>
                        <th>Date</th>
                        <th>Attendance Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in ViewBag.Sessions)
                    {
                        <tr onclick="window.location.href='@Url.Action("Details", "Session",
                         new { ID = session.ID })'" style="cursor:pointer;">
                            <td>@session.Chapter.City</td>
                            <td>@session.Date.ToShortDateString()</td>
                            <td>@(session.AttendanceRate * 100)%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

@*         <div class="col-md-6 flex-column" title="Click on any singer to go to that singer's details">
            <partial name="Partials/_SingerIndexPartial" />
        </div> *@


    </div>
    <div class="text-center mt-3">
        <h2 class="mb-3">Actions</h2>
        <div class="row g-3">
            <div class="col-md-4 d-grid">
                <a title="Will bring you to the 'Create Session' page" id="btnCreateSession" type="submit" class="btn btn-success py-5" asp-action="Create" asp-controller="Session">Create Session</a>
            </div>
            <div class="col-md-4 d-grid">
                <a title="Brings you to the Singer page and brings you to the 'Bulk Upload' feature"
                   id="btnBulkUpload" class="btn btn-warning py-5" type="submit" asp-action="Index" asp-controller="Singer">Singer Bulk Upload</a>
            </div>
            <div class="col-md-4 d-grid">
                <a asp-action="ExportData" asp-controller="Session" class="btn btn-info py-5" title="Export the sessions to an excel (.xlsx) file">Export All Session's</a>
            </div>
        </div>
    </div>
}
