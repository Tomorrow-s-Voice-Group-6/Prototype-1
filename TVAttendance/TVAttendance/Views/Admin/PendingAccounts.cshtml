@model List<dynamic>  
@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "Unassigned Users";
}

<h2>Users With Pending Account Creation</h2>

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Username</th>
                <th>Email Status</th>
                <th>Account Information Filled</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var user = item.User;  
                var accountInfoFilled = item.AccountInfoFilled;  

                <tr>
                    <td>@user.Email</td>
                    <td>@user.UserName</td>
                    <td>
                        @if (user.EmailConfirmed)
                        {
                            <span class="text-success">Accepted</span>
                        }
                        else
                        {
                            <span class="text-secondary">Pending</span>
                        }
                    </td>
                    <td>
                        @if (accountInfoFilled)
                        {
                            <span class="text-success">True</span>
                        }
                        else
                        {
                            <span class="text-danger">False</span>
                        }
                    </td>
                    <td>
                        @if (accountInfoFilled)
                        {
                            <a asp-action="PendingAccountDetails" asp-route-id="@user.Id" class="btn btn-info">Details</a>
                            <form method="post" asp-action="ConfirmVolunteer" asp-route-id="@user.Id" class="d-inline-block">
                                <button type="submit" class="btn btn-success">Accept</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">Information Missing</span>
                        }

                        <div class="mt-2">
                            <form method="post" asp-action="DenyUser" asp-route-id="@user.Id" class="d-inline-block mr-2">
                                <button type="submit" class="btn btn-danger">Deny</button>
                            </form>
                            @if (user.EmailConfirmed == false)
                            {
                                <form method="post" asp-action="EmailAcceptUser" asp-route-id="@user.Id" class="d-inline-block">
                                    <button type="submit" class="btn btn-danger">Force Register</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No users found without roles.</p>
}
